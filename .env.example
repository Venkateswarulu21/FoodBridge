# Copy these into your IDE run configuration / shell. Never commit real values.
DB_URL=jdbc:mysql://localhost:3306/food_bridge?useSSL=false&serverTimezone=UTC&allowPublicKeyRetrieval=true
DB_USERNAME=root
DB_PASSWORD=your_mysql_password

# Real email OTPs. Gmail example: turn on 2-Step Verification, then create an
# "App password" at https://myaccount.google.com/apppasswords and use it below.
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=yourname@gmail.com
MAIL_PASSWORD=your_16_char_app_password
# MAIL_FROM=yourname@gmail.com

# Where donor photos are stored (default: ./uploads)
# UPLOAD_DIR=uploads
